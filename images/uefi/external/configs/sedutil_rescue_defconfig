# sedutil Rescue USB: a root shell with sedutil-cli, for recovery.
# UEFI x86-64 only. Boots straight to a root shell on the console.

BR2_x86_64=y
BR2_x86_x86_64=y

# Prebuilt Bootlin toolchain: saves building GCC in CI
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y

BR2_TARGET_GENERIC_HOSTNAME="sedutil-rescue"
BR2_TARGET_GENERIC_ISSUE="sedutil Rescue"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SEDUTIL_PATH)/board/rescue/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SEDUTIL_PATH)/board/rescue/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SEDUTIL_PATH)/board/common/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="rescue"

# Linux 6.18 longterm, everything built in, initramfs and command line
# embedded, booted directly by UEFI through the kernel's EFI stub
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.65"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SEDUTIL_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_SEDUTIL_PATH)/board/rescue/linux-cmdline.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

BR2_PACKAGE_SEDUTIL=y

BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Recovery tools beyond sedutil-cli and BusyBox
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_NVME=y
BR2_PACKAGE_KBD=y
