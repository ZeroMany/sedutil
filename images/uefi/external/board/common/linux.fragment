# sedutil PBA and Rescue kernel, on top of x86_64_defconfig.
# Everything the PBA needs is built in; there are no loadable modules.

CONFIG_LOCALVERSION="-sedutil"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set

# UEFI: the kernel is the EFI application (EFI stub), with the initramfs
# inside it, so one signed file covers everything that runs.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# CONFIG_EFI_MIXED is not set
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_XZ=y
CONFIG_RD_XZ=y
CONFIG_KERNEL_XZ=y

# The command line is fixed at build time (see linux-cmdline.fragment);
# anything the firmware or a boot menu passes is ignored.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE_OVERRIDE=y

# Drives: NVMe, SATA through AHCI, USB storage (BOT and UAS)
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# USB host controllers and keyboards
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_HID_APPLE=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CORSAIR=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_RAZER=y
CONFIG_HID_STEELSERIES=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# Console on the UEFI framebuffer (GOP); no GPU drivers
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# Serial port, used by the CI boot test to read the PBA's status lines
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Hardening: no SysRq, reboot 5 seconds after a panic, no kexec,
# no hibernation, no network devices, no sound
# CONFIG_MAGIC_SYSRQ is not set
CONFIG_PANIC_TIMEOUT=5
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_SOUND is not set
# CONFIG_BT is not set
# CONFIG_NFS_FS is not set
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity"
